# Abstract ABA public website — copy to apps/website/.env
#
# Vite inlines VITE_* variables into the client bundle at build time, so every
# value here is PUBLIC. Never put a secret here — email and API credentials stay
# in apps/api only.

# Base URL of the existing API. In development the default "/api" goes through
# the Vite proxy (VITE_API_PROXY_TARGET, default http://localhost:4000). In
# production set the API's public base, e.g. https://api.your-domain.com/api,
# and add this website's origin to the API's CORS_ORIGINS.
VITE_API_BASE_URL=/api

# Base URL of the existing web panel (apps/web). "Sign In" links to
# <VITE_WEB_APP_URL>/login — the website has no login of its own.
VITE_WEB_APP_URL=http://localhost:3000
