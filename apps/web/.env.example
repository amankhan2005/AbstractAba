# Abstract ABA tenant web app — copy to apps/web/.env
#
# Vite inlines VITE_* variables into the client bundle at build time, so every
# value here is PUBLIC. Never put a secret in this file or in the web build.

# API base URL the SPA calls. In development this defaults to the same-origin
# "/api" proxy (see VITE_API_PROXY_TARGET). In production set it to your API's
# public base, e.g. https://api.your-domain.com/api
VITE_API_BASE_URL=/api

# development | staging | production
VITE_APP_ENV=development

# Dev-only: where the Vite "/api" proxy forwards to. Not used in a production
# build. Defaults to http://localhost:4000 when unset.
VITE_API_PROXY_TARGET=http://localhost:4000
