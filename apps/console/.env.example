# Platform Console (Super Admin) — copy to apps/console/.env
#
# Vite inlines VITE_* variables into the client bundle at build time, so
# everything here is PUBLIC. Never put a secret here.
#
# This is the platform-operator surface. The blueprint requires multi-factor
# for all users and stricter session limits on it, so deploy it on a separate
# host from the tenant portal rather than a path on the same one.

VITE_API_BASE_URL=http://localhost:4000/api/v1

VITE_APP_ENV=development
